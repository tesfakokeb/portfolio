# Server
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed CORS origins (frontend URLs)
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://portfolio-v6z9.onrender.com,https://tesfaworku.com,https://www.tesfaworku.com

# Public URL of the deployed frontend. Used for links inside emails
# (password reset). Must be the real site URL, never localhost.
CLIENT_URL=https://portfolio-v6z9.onrender.com

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=portfolio_db

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Nodemailer / SMTP configuration for the contact form
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
CONTACT_RECEIVER=tesfa.worku@nasa.gov

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100

# Cloudinary (for production image/file uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
